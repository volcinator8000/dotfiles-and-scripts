#!/usr/bin/env bash
# Commit and push the dotfiles repo if anything changed. Run by dots-sync.timer weekly, or by hand.
set -euo pipefail
R="${DOTFILES_DIR:-$HOME/dotfiles-and-scripts}"
export GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=15"
cd "$R"
git add -A
if ! git diff --cached --quiet; then
    git commit -q -m "auto-sync $(date +%Y-%m-%d) from $(uname -n)"
    echo "committed: $(git log -1 --pretty=%s)"
fi
git pull -q --rebase --autostash origin main || echo "pull failed (offline?)"
git push -q origin main && echo "pushed $(git rev-parse --short HEAD)" || echo "push failed (offline?)"
