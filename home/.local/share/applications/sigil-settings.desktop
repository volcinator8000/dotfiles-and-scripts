[Desktop Entry]
Type=Application
Name=Sigil Settings
Comment=Control panel for the rice: key sounds, power, idle timers, wallpaper, services
Exec=sh -c 'python3 ~/.config/sigil-settings/sigil-settings.py'
Icon=preferences-system
Terminal=false
Categories=Settings;System;
StartupWMClass=io.sigil.Settings
Keywords=settings;keysound;power;wallpaper;
