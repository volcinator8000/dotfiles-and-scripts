#!/usr/bin/env python3
"""Measure drawing-tablet position/pressure jitter and Bluetooth report rate.

Waits for pen contact, samples for a few seconds, then reports the *stillest*
0.4 s window it saw -- so a little drift while you settle does not spoil the
number. Position noise well under 0.05 mm means the tablet is solid and any
wobble in your lines is the hand, not the hardware.

Usage: tablet-jitter [/dev/input/eventN] [seconds]
       tablet-jitter buttons        -- name every pen/pad button as you press it
"""
import struct, sys, time, os, statistics as st

FMT = "llHHi"
SZ = struct.calcsize(FMT)
SYN, KEY, ABS = 0, 1, 3
ABS_X, ABS_Y, ABS_P = 0, 1, 0x18
BTN_TOUCH = 0x14a
WINDOW = 0.4


def find_pen():
    """First '... Pen' device in /proc/bus/input/devices, matched on the name line only."""
    for block in open("/proc/bus/input/devices").read().split("\n\n"):
        name = ""
        for line in block.splitlines():
            if line.startswith("N: Name="):
                name = line.split("=", 1)[1].strip('"')
        if not name.endswith("Pen"):
            continue
        for line in block.splitlines():
            if line.startswith("H: Handlers="):
                for tok in line.split("=", 1)[1].split():
                    if tok.startswith("event"):
                        return "/dev/input/" + tok, name
    return None, None


BUTTONS = {
    0x110: "BTN_LEFT (pen tip / left click)",
    0x111: "BTN_RIGHT",
    0x112: "BTN_MIDDLE",
    0x140: "BTN_TOOL_PEN (pen in range)",
    0x14a: "BTN_TOUCH (tip pressed)",
    0x14b: "BTN_STYLUS  <- lower barrel button",
    0x14c: "BTN_STYLUS2 <- upper barrel button",
    0x100: "BTN_0 <- ExpressKey 1",
    0x101: "BTN_1 <- ExpressKey 2",
    0x102: "BTN_2 <- ExpressKey 3",
    0x103: "BTN_3 <- ExpressKey 4",
}


def find_nodes():
    """Every '<name> Pen' / '<name> Pad' node, as [(path, name), ...]."""
    out = []
    for block in open("/proc/bus/input/devices").read().split("\n\n"):
        name = node = None
        for line in block.splitlines():
            if line.startswith("N: Name="):
                name = line.split("=", 1)[1].strip('"')
            elif line.startswith("H: Handlers="):
                node = next((t for t in line.split("=", 1)[1].split() if t.startswith("event")), None)
        if name and node and (name.endswith(" Pen") or name.endswith(" Pad")):
            out.append(("/dev/input/" + node, name))
    return out


def watch_buttons():
    """Print every button press/release on the tablet until 20 s of silence."""
    import select
    nodes = find_nodes()
    if not nodes:
        sys.exit("no tablet found (is it awake and connected?)")
    fds = {}
    for path, name in nodes:
        try:
            f = open(path, "rb", buffering=0)
        except PermissionError:
            sys.exit(f"cannot read {path} -- you need to be in the 'input' group")
        fds[f.fileno()] = (f, name)
        print(f"watching {name:<26} {path}")
    print("\n>>> Hold the pen near the tablet and press its two barrel buttons.")
    print(">>> Then try the 4 keys on the tablet itself. Ctrl-C or 20 s idle to stop.\n")
    seen, last = set(), time.time()
    try:
        while time.time() - last < 20:
            ready, _, _ = select.select(list(fds), [], [], 1.0)
            for fd in ready:
                f, name = fds[fd]
                data = f.read(SZ)
                while data:
                    _, _, typ, code, val = struct.unpack(FMT, data[:SZ])
                    if typ == KEY and val in (0, 1):
                        label = BUTTONS.get(code, f"code 0x{code:x}")
                        print(f"  {name:<26} {'PRESS  ' if val else 'release'} {label}")
                        seen.add((name, code, label))
                        last = time.time()
                    data = data[SZ:]
    except KeyboardInterrupt:
        pass
    print("\n--- buttons seen ---")
    if not seen:
        print("  none -- the pen must be within a centimetre or two of the surface")
    for name, code, label in sorted(seen, key=lambda x: (x[0], x[1])):
        print(f"  {name:<26} 0x{code:03x}  {label}")


def main():
    args = [a for a in sys.argv[1:]]
    if args and args[0] == "buttons":
        return watch_buttons()
    dev = next((a for a in args if a.startswith("/dev/")), None)
    dur = next((float(a) for a in args if not a.startswith("/dev/")), 8.0)
    name = None
    if dev is None:
        dev, name = find_pen()
    if dev is None:
        sys.exit("no tablet pen device found (is the tablet connected?)")
    try:
        fd = open(dev, "rb", buffering=0)
    except PermissionError:
        sys.exit(f"cannot read {dev} -- you need to be in the 'input' group")
    os.set_blocking(fd.fileno(), False)

    print(f"device : {name or dev}  ({dev})")
    print("\n>>> Press the pen ON the tablet and hold it as STILL as you can.")
    print(">>> Sampling starts automatically on contact.\n")

    cur, touch, started, pts = {}, False, None, []
    t0 = time.time()
    while True:
        if started and time.time() - started > dur:
            break
        if not started and time.time() - t0 > 60:
            sys.exit("timed out waiting for pen contact")
        try:
            data = fd.read(SZ)
        except BlockingIOError:
            data = None
        if not data:
            time.sleep(0.0005)
            continue
        sec, usec, typ, code, val = struct.unpack(FMT, data)
        if typ == KEY and code == BTN_TOUCH:
            touch = bool(val)
            if touch and not started:
                started = time.time()
                print(f"contact -- sampling {dur:.0f}s, hold still ...")
        elif typ == ABS:
            cur[code] = val
        elif typ == SYN and touch and started and ABS_X in cur and ABS_Y in cur and cur.get(ABS_P, 0) > 0:
            pts.append((sec + usec / 1e6, cur[ABS_X], cur[ABS_Y], cur[ABS_P]))

    if len(pts) < 50:
        sys.exit(f"only {len(pts)} samples -- keep the pen pressed for the whole {dur:.0f}s")

    ts = [p[0] for p in pts]
    span = ts[-1] - ts[0]
    gaps = [ts[i + 1] - ts[i] for i in range(len(ts) - 1)]
    med = st.median(gaps)
    stalls = len([g for g in gaps if g > 3 * med])
    print(f"\nsamples {len(pts)} over {span:.1f}s  ->  {len(pts) / span:.0f} Hz report rate")
    print(f"inter-packet: median {med * 1000:.2f} ms   max {max(gaps) * 1000:.1f} ms   stalls>3x median: {stalls}")

    best = None
    for i in range(len(pts)):
        j = i
        while j < len(pts) and pts[j][0] - pts[i][0] < WINDOW:
            j += 1
        if j - i < 15:
            continue
        w = pts[i:j]
        rad = (st.pstdev([q[1] for q in w]) ** 2 + st.pstdev([q[2] for q in w]) ** 2) ** 0.5
        if best is None or rad < best[0]:
            best = (rad, w)
    if best is None:
        sys.exit("not enough contiguous samples to analyse")

    rad, w = best
    xs, ys, ps = [q[1] for q in w], [q[2] for q in w], [q[3] for q in w]
    print(f"\nstillest {WINDOW}s window ({len(w)} samples):")
    print(f"  radial stddev {rad:6.1f} units = {rad / 100:.3f} mm")
    print(f"  X spread {(max(xs) - min(xs)) / 100:.3f} mm    Y spread {(max(ys) - min(ys)) / 100:.3f} mm")
    print(f"  pressure mean {st.mean(ps):.0f}  stddev {st.pstdev(ps):.1f}")

    mm = rad / 100
    verdict = ("EXCELLENT (<0.05 mm) -- tablet is solid, any wobble is your hand" if mm < 0.05 else
               "GOOD (<0.10 mm) -- normal for a hand-held pen" if mm < 0.10 else
               "OK (<0.20 mm)" if mm < 0.20 else
               "HIGH -- possible Bluetooth interference, retry over USB to compare")
    print(f"\nposition noise: {verdict}")
    if stalls or len(pts) / span < 100:
        print("note: low report rate or packet stalls make fast strokes look polygonal,\n"
              "      which feels like shakiness. Compare the same test over USB.")


if __name__ == "__main__":
    main()
