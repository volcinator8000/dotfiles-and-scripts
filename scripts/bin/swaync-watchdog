#!/usr/bin/env bash
# Restart swaync if it has been spinning (>70% of a core over ~20 s). swaync 0.12.6 sometimes locks into a
# busy loop after a crash/restart (seen 2026-09-09: 100% CPU, CPU at 80 °C). Run by swaync-watchdog.timer every minute.
P=$(pgrep -x swaync | head -1) || exit 0
a=$(awk '{print $14+$15}' /proc/$P/stat 2>/dev/null) || exit 0; sleep 20
b=$(awk '{print $14+$15}' /proc/$P/stat 2>/dev/null) || exit 0
pct=$(( (b - a) * 100 / 2000 ))   # clock ticks (100/s) over 20 s
if (( pct > 70 )); then
    echo "swaync at ${pct}% cpu for 20 s, restarting"
    systemctl --user restart swaync
    sleep 3; notify-send -a watchdog -i dialog-warning "swaync restarted" "it was spinning at ${pct}% CPU"
fi
