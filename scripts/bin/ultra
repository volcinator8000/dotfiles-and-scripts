#!/usr/bin/env bash
# ultra: ultra power saver / super focus mode. Usage: ultra on|off|toggle|state|status|json
#
# Squeezes the battery as far as the userland can reach, with one optional root helper for
# the rest. Everything is undone by `ultra off`, and nothing here survives a reboot.
#
#   compositor   animations, blur, shadows, inactive fade, rounding off; hardware cursor;
#                panel to its lowest refresh mode; wallpaper daemon gone, plain base colour
#   session      minimal bar (config-ultra.jsonc), aggressive idle timers (dim 30 s, lock 2 min,
#                screen off 3 min, suspend 5 min), key sounds and night light stopped,
#                power-saver profile, backlight capped, bluetooth off
#   apps         the ones in ultra_quit_apps are closed and relaunched on exit (default: the
#                chat/music trio that lives in the special workspaces; they are the biggest
#                wakeup sources on this box)
#   root helper  sigil-powerctl (sudo, no password, see system/): CPU boost off, max clock
#                capped, panel ABM (adaptive backlight) on. Skipped with a note if not installed.
#
# Knobs live in ~/.config/hypr/power-auto.conf (ultra_* keys, edited on the settings app's
# Power page). battery.sh leaves the mode when the charger is plugged (ultra_exit_on_ac) and
# can enter it below a percentage (ultra_at_pct, 0 = never).
set -u
CFG=~/.config; PA=$CFG/hypr/power-auto.conf
RT="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"; ST="$RT/ultra"
KS=$CFG/keysound/keysound.sh; HELPER=/usr/local/bin/sigil-powerctl
pa() {  # key default: a key that is present but empty stays empty (e.g. no apps to close)
    local line; line=$(grep -m1 "^$1=" "$PA" 2>/dev/null); if [ -n "$line" ]; then echo "${line#*=}"; else echo "$2"; fi
}
active() { [ -f "$ST/active" ]; }
hexec() { hyprctl dispatch "hl.dsp.exec_cmd(\"$1\")" >/dev/null 2>&1; }   # launched by Hyprland: same env/tree as autostart
heval() { hyprctl eval "$1" >/dev/null 2>&1; }
kill_by_name() {  # pkill -x is limited to 15 chars of comm; fall back to the full command line
    if [ ${#1} -le 15 ]; then pkill -x "$1"; else pkill -f "(^|/)$1( |$)"; fi
}
running() { if [ ${#1} -le 15 ]; then pgrep -x "$1" >/dev/null; else pgrep -f "(^|/)$1( |$)" >/dev/null; fi; }
# how each closable app comes back (anything not listed is relaunched by name)
relaunch_cmd() {
    case "$1" in
        vesktop|slack|spotify) echo "[workspace special:$1 silent] $1" ;;
        kdeconnect) echo "kdeconnect-indicator" ;;
        *) echo "$1" ;;
    esac
}
helper_ok() { command -v sudo >/dev/null && [ -x "$HELPER" ] && sudo -n "$HELPER" status >/dev/null 2>&1; }

lowest_mode() {  # current resolution at the lowest refresh the panel offers, "" if it is already the lowest
    hyprctl monitors -j 2>/dev/null | python3 -c '
import json, sys
try:
    ms = json.load(sys.stdin)
    m = next((x for x in ms if x["name"].startswith("eDP")), ms[0])  # the laptop panel, not whatever is plugged in
except Exception:
    sys.exit(0)
w, h, cur = m["width"], m["height"], m["refreshRate"]
rates = sorted({float(x.split("@")[1].rstrip("Hz")) for x in m.get("availableModes", []) if x.startswith(f"{w}x{h}@")})
if rates and rates[0] < cur - 0.5:
    print(m["name"], f"{w}x{h}@{rates[0]:.2f}")
'
}

ultra_on() {
    active && { echo "ultra: already on"; return 0; }
    mkdir -p "$ST"; touch "$ST/active"   # from here on battery.sh and the bar see the mode as on
    powerprofilesctl get > "$ST/profile" 2>/dev/null
    brightnessctl -m 2>/dev/null | cut -d, -f4 | tr -d % > "$ST/brightness"
    : > "$ST/apps"; : > "$ST/daemons"

    # power profile first: dgpu-perf-pin releases the dGPU as soon as we leave "performance"
    powerprofilesctl set power-saver 2>/dev/null

    # compositor: no eye candy, hardware cursor, plain background
    heval 'hl.config({
        animations = { enabled = false },
        decoration = { blur = { enabled = false }, shadow = { enabled = false }, inactive_opacity = 1.0, active_opacity = 1.0, rounding = 0 },
        cursor = { no_hardware_cursors = false },
        misc = { background_color = "rgb(050507)", vrr = 0 },
    })'
    if [ "$(pa ultra_refresh true)" = true ]; then
        read -r mon mode <<< "$(lowest_mode)"
        [ -n "${mode:-}" ] && heval "hl.monitor({ output = \"$mon\", mode = \"$mode\", position = \"auto\", scale = 1 })"
    fi
    if running hyprpaper; then echo hyprpaper >> "$ST/daemons"; pkill -x hyprpaper; fi

    # bar and idle daemon: minimal variants
    pkill -x waybar; hexec "waybar -c $CFG/waybar/config-ultra.jsonc -s $CFG/waybar/style.css"
    {   # keep the general block (lock script, sleep hooks) from the real config, replace the timers
        awk '/^general/,/^}/' "$CFG/hypr/hypridle.conf"
        printf '\n# ultra mode timers (generated by %s)\n' "$0"
        printf 'listener {\n    timeout = 30\n    on-timeout = brightnessctl -s set 10%%\n    on-resume = brightnessctl -r\n}\n'
        printf 'listener {\n    timeout = 120\n    on-timeout = loginctl lock-session\n}\n'
        printf 'listener {\n    timeout = 180\n    on-timeout = hyprctl dispatch %s\n    on-resume = hyprctl dispatch %s\n}\n' "'hl.dsp.dpms(\"off\")'" "'hl.dsp.dpms(\"on\")'"
        printf 'listener {\n    timeout = 300\n    on-timeout = systemctl suspend\n}\n'
    } > "$ST/hypridle.conf"
    pkill -x hypridle; hexec "hypridle -c $ST/hypridle.conf"

    # background daemons that only exist for the experience
    if [ "$("$KS" state 2>/dev/null)" = true ]; then echo keysound >> "$ST/daemons"; "$KS" stop >/dev/null 2>&1; fi
    if running hyprsunset; then echo hyprsunset >> "$ST/daemons"; pkill -x hyprsunset; fi

    # apps
    for app in $(pa ultra_quit_apps "vesktop slack spotify"); do
        case "$app" in
            kdeconnect) if running kdeconnectd || running kdeconnect-indicator; then echo "$app" >> "$ST/apps"; kill_by_name kdeconnect-indicator; kill_by_name kdeconnectd; fi ;;
            *) if running "$app"; then echo "$app" >> "$ST/apps"; kill_by_name "$app"; fi ;;
        esac
    done

    # radios and panel
    if [ "$(pa ultra_bluetooth_off true)" = true ] && bluetoothctl show 2>/dev/null | grep -q 'Powered: yes'; then
        echo bluetooth >> "$ST/daemons"; bluetoothctl power off >/dev/null 2>&1
    fi
    lvl=$(pa ultra_brightness 30); cur=$(cat "$ST/brightness")
    [ "${cur:-0}" -gt "$lvl" ] 2>/dev/null && brightnessctl -q set "$lvl%"

    # root side
    root_note=""
    if helper_ok; then
        sudo -n "$HELPER" ultra on "$(pa ultra_max_mhz 2400)" "$(pa ultra_abm 3)" >/dev/null 2>&1 && root_note="CPU capped at $(pa ultra_max_mhz 2400) MHz, boost off, panel ABM $(pa ultra_abm 3)" || root_note="root helper failed"
    else
        root_note="no root helper (see README: sigil-powerctl)"
    fi

    pkill -RTMIN+12 -x waybar   # ULTRA cell
    "$KS" play toggle-on >/dev/null 2>&1 &
    closed=$(tr '\n' ' ' < "$ST/apps"); closed=${closed% }
    notify-send -a power -i battery-low "Ultra power saver on" "${closed:+closed: $closed
}${root_note}" 2>/dev/null
    echo "ultra: on${root_note:+ ($root_note)}"
}

ultra_off() {
    active || { echo "ultra: already off"; return 0; }
    rm -f "$ST/active"
    helper_ok && sudo -n "$HELPER" ultra off >/dev/null 2>&1

    hyprctl reload >/dev/null 2>&1        # hyprland.lua is the source of truth: effects, cursor, monitor mode all come back
    pkill -x waybar;  hexec "waybar"
    pkill -x hypridle; hexec "hypridle"

    grep -qx hyprpaper  "$ST/daemons" 2>/dev/null && hexec "hyprpaper"
    grep -qx keysound   "$ST/daemons" 2>/dev/null && "$KS" start >/dev/null 2>&1
    grep -qx hyprsunset "$ST/daemons" 2>/dev/null && hexec "$CFG/swaync/nightlight.sh autostart"
    grep -qx bluetooth  "$ST/daemons" 2>/dev/null && bluetoothctl power on >/dev/null 2>&1
    while read -r app; do [ -n "$app" ] && hexec "$(relaunch_cmd "$app")"; done < "$ST/apps"

    b=$(cat "$ST/brightness" 2>/dev/null); [ -n "$b" ] && brightnessctl -q set "$b%"
    if [ "${1:-}" != "--keep-profile" ]; then p=$(cat "$ST/profile" 2>/dev/null); [ -n "$p" ] && powerprofilesctl set "$p" 2>/dev/null; fi
    rm -rf "$ST"
    "$KS" play toggle-off >/dev/null 2>&1 &
    notify-send -a power -i battery-good "Ultra power saver off" "everything restored" 2>/dev/null
    echo "ultra: off"
}

case "${1:-toggle}" in
    on)     ultra_on ;;
    off)    ultra_off "${2:-}" ;;
    toggle) if active; then ultra_off; else ultra_on; fi ;;
    state)  active && echo true || echo false ;;
    json)   if active; then echo '{"text":"󰌪 ULTRA","class":"on","tooltip":"ultra power saver: click to leave"}'; else echo '{"text":"","class":"off"}'; fi ;;
    status)
        if active; then
            echo "ultra: on (since $(date -r "$ST/active" +%H:%M))"
            echo "  saved profile $(cat "$ST/profile" 2>/dev/null) · brightness $(cat "$ST/brightness" 2>/dev/null)%"
            echo "  closed apps: $(tr '\n' ' ' < "$ST/apps" 2>/dev/null)"
            echo "  stopped: $(tr '\n' ' ' < "$ST/daemons" 2>/dev/null)"
        else echo "ultra: off"; fi
        panel=$(hyprctl monitors -j 2>/dev/null | python3 -c 'import json,sys; ms=json.load(sys.stdin); m=next((x for x in ms if x["name"].startswith("eDP")), ms[0]); print("%dx%d@%.0f" % (m["width"], m["height"], m["refreshRate"]))' 2>/dev/null)
        echo "  panel: $panel · profile $(powerprofilesctl get 2>/dev/null) · $(brightnessctl -m 2>/dev/null | cut -d, -f4) backlight"
        if helper_ok; then echo "  root helper: $(sudo -n "$HELPER" status 2>/dev/null | tr '\n' ' ')"; else echo "  root helper: not installed (sudoers + $HELPER, see README)"; fi
        upower -i "$(upower -e | grep -m1 BAT)" 2>/dev/null | awk -F': *' '/energy-rate:/{r=$2} /time to empty:/{t=$2} /percentage:/{p=$2} END{printf "  battery: %s · %s · %s\n", p, r, t?t:"not discharging"}' ;;
    *) echo "usage: ultra on|off|toggle|state|status|json"; exit 2 ;;
esac
